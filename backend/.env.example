# Django Configuration
SECRET_KEY=your_strong_random_secret_key_here
DEBUG=False
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Manila

# CORS & CSRF (Comma-separated origins of your deployed frontend)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.vercel.app,http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=False

# Database Configuration (MySQL / PostgreSQL)
# Option A: Full Connection String (Render / TiDB / Aiven / Supabase)
# DATABASE_URL=mysql://user:password@host:port/dbname
# Option B: Individual fields
DB_ENGINE=mysql.connector.django
DB_NAME=avica_db
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email SMTP Settings (Optional, for email verification / notifications)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password

# External APIs
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DAMAGE_DETECTION_API_KEY=
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
